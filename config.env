# Shared settings for every script, the Makefile and CI.
# Edit these once; everything else reads from here.

# GCP project that hosts every experiment.
GCP_PROJECT=my-experiments-project

# Region for Cloud Run services (and the serverless load balancer backends).
GCP_REGION=europe-west2

# Optional. When set (and `make infra` has created the load balancer),
# every project is served at https://<slug>.<DOMAIN> and `www` at https://<DOMAIN>.
# Leave empty to just use the *.run.app URLs.
DOMAIN=

# Defaults applied to every service unless a project's project.json overrides them.
DEFAULT_MEMORY=256Mi
DEFAULT_CPU=1
DEFAULT_MAX_INSTANCES=2
